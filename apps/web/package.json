{
  "name": "web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host :: --port 3000",
    "build": "node tools/generate-seo-files.mjs && vite build --outDir ../../dist/apps/web --emptyOutDir",
